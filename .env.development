# 本地开发环境变量（vite dev 只加载 .env.development）
# 账号体系直连 api.tthaoke.com；若想连本地 ttapi，可在这里改成 http://api.tthaoke.com/ 或本地域名
# 注意：ttapi 的 config/cors.inc.php 已放行 localhost:* 与 127.0.0.1:*
# 业务接口（项目 / 图标 / 收藏）默认连 https://uiapi.tthaoke.com/ ，本地 uiapi 已配置同名 host
# VITE_PUBLIC_API_HOST=https://api.tthaoke.com/
# VITE_ICON_API_HOST=https://uiapi.tthaoke.com/
